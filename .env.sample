# Optional per-Mac settings. Copy to .env; process/per-agent values win.
# Relative paths use this file's directory. ~/ is expanded; shell expressions
# such as ${HOME} are not evaluated.
# Select SHIM_ENV_FILE or SHIM_CONFIG_ROOT from the process environment only.

# AGY_CLI_BIN="~/.local/bin/agy"
# Optional path for an existing standalone ACP installation:
# AGY_ACP_BIN="~/Library/Application Support/agy-acp/agy_acp_server.par"
# AGY_ACP_AUTH_METHOD=

# MAKA_BIN=maka
# MAKA_WORKSPACE="~/Library/Application Support/Maka/workspaces/default"
# MAKA_HOST_URL=ws://127.0.0.1:64150/runtime-host
# Workspace/URL select ops inspection targets; configure Maka itself to match.

# SHIM_BIN=~/.local/bin/grok
# RAFT_APP_PATH="/Applications/Raft Desktop.app"
# RAFT_HOME=~/.slock
# RAFT_COMPUTER_BIN=~/.local/bin/raft-computer
# RAFT_SOURCE=../raft-source

# Prefer per-agent settings for mixed-backend installations:
# GROK_SHIM_PROFILE=agy
# GROK_SHIM_DEBUG=1
# Optional when a real Grok CLI is also installed: force this bridge.
# RAFT_GROK_BACKEND=shim

# Custom backend arguments with spaces use a JSON array:
# GROK_SHIM_BACKEND_ARGS='["/path with spaces/backend.mjs","--flag"]'
